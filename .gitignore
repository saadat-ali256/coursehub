# CourseHub - Git Ignore

# Dependencies
node_modules/
**/node_modules/

# Package managers
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
**/.next/
out/
**/out/

# Build files
build/
**/build/
dist/
**/dist/

# Testing and coverage
coverage/
**/coverage/

# Environment variables and secrets
.env*
**/.env*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# Deployment
.vercel/
.netlify/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Cache
.cache/
.turbo/
.eslintcache

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Local database files
*.sqlite
*.sqlite3

# Local uploads
uploads/